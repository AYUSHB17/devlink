{
  "name": "devlink",
  "productName": "DevLink",
  "version": "0.1.0",
  "description": "Use your Mac and Windows PC together: secure pairing, clipboard sync, file drop, port forwarding and shortcuts over the LAN.",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.js",
    "start": "npm run build && electron .",
    "start:b": "npm run build && DEVLINK_PROFILE=b DEVLINK_PORT=47822 electron .",
    "smoke": "npm run build && electron . --smoke",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dist": "npm run build:native && npm run build && electron-builder",
    "dist:mac": "npm run build:native && npm run build && electron-builder --mac",
    "dist:win": "npm run build:native && npm run build && electron-builder --win",
    "build:native": "cargo build --release --manifest-path native/devlink-input/Cargo.toml"
  },
  "build": {
    "appId": "in.optimist.devlink",
    "productName": "DevLink",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "native/devlink-input/target/release/devlink-input",
          "to": "devlink-input"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "native/devlink-input/target/release/devlink-input.exe",
          "to": "devlink-input.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "author": "Ayush <ayush@optimist.in>"
}
